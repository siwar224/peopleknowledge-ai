# Copy to .env (never committed) and adapt. Every value below is optional:
# the defaults work with the local embedded Qdrant and bge-m3.

# API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Embeddings (local, free): must be the model used by scripts/index_chunks.py
EMBEDDING_MODEL=BAAI/bge-m3
# Hugging Face cache where the model was downloaded (only needed if the system variable is not set)
HF_HOME=D:\huggingface
# The API never downloads a model (a missing model is an error)
HF_HUB_OFFLINE=true

# Vector store. Empty QDRANT_URL = local embedded mode (folder QDRANT_PATH, default
# datasets/indexes/qdrant). Set QDRANT_URL for a Qdrant server (Docker) or Qdrant Cloud.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=peopleknowledge

# Generation: local llama.cpp server (OpenAI-compatible) with Qwen
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=local
LLM_MODEL=qwen2.5-1.5b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=300
LLM_TIMEOUT_SECONDS=120

# Retrieval options (see src/peopleknowledge/retrieval/retriever.py). Each one is
# measured with scripts/evaluate_retrieval.py (--hybrid, --profile, --reranker) before
# being switched on here.
RETRIEVAL_HYBRID=false
RETRIEVAL_PROFILE=true
RETRIEVAL_MAX_RECORDS=3
RETRIEVAL_CANDIDATES=30
# Cross-encoder reranker, e.g. BAAI/bge-reranker-v2-m3 (about 2.3 GB): download it once
# on purpose (the API never downloads a model), then set its name here. Empty = off.
RERANKER_MODEL=
